source("renv/activate.R")

# First-time setup hint — shown only when packages are not yet installed
if (interactive() && !requireNamespace("shiny", quietly = TRUE)) {
  message(
    "\n[Wu AI Harness] Packages not yet installed.",
    "\nRun the following in the console to set up your environment:\n",
    "\n  source(\"setup.R\")\n",
    "\nThis will take several minutes on a fresh machine.\n"
  )
}
